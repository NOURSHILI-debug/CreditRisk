# ==============================================================================
# Credit Risk Intelligence Platform — Environment Variable Template
# Person 2: FastAPI backend, Streamlit dashboard, LangGraph AI agent
#
# Copy this file to `.env` and fill in actual values for local development.
# NEVER commit `.env` to version control. It is gitignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# Shared / general
# ------------------------------------------------------------------------------

# Application environment: local | testing | production
ENVIRONMENT=local

# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# FastAPI backend (Person 2)
# ------------------------------------------------------------------------------

# Host the API binds to (0.0.0.0 for container/Docker; 127.0.0.1 for local)
API_HOST=0.0.0.0

# Port the API listens on
API_PORT=8000

# Path to the trained model artifacts directory.
# Relative values resolve against the project root. Default: models/local_v2
# Person 1 must provide these artifacts (xgboost_baseline.json, preprocessor.pkl, etc.).
CREDIT_RISK_MODEL_DIR=models/local_v2

# Path to the application training dataset.
# Relative values resolve against the project root. Default: data/raw/application_train.csv
# Person 1 must provide this file.
CREDIT_RISK_APPLICATION_DATA=data/raw/application_train.csv

# Comma-separated list of allowed CORS origins for the API
CREDIT_RISK_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# Streamlit dashboard (Person 2)
# ------------------------------------------------------------------------------

# Host the dashboard binds to
DASHBOARD_HOST=0.0.0.0

# Port the dashboard listens on
DASHBOARD_PORT=8501

# Backend API URL — the dashboard calls this to fetch data and predictions.
# In Docker Compose, use the FastAPI service name: http://fastapi:8000
# In AWS ECS/Fargate, use the FastAPI service endpoint.
# Do NOT hardcode localhost in production.
CREDIT_RISK_API_URL=http://localhost:8000

# Data mode: "api" (default, production) or "mock" (development/testing only).
# When "mock", the dashboard uses deterministic synthetic data instead of calling
# the API. API errors never silently fall back to mock data.
CREDIT_RISK_DATA_MODE=api

# Mock provider settings (only used when CREDIT_RISK_DATA_MODE=mock)
CREDIT_RISK_MOCK_SAMPLE_SIZE=300
CREDIT_RISK_MOCK_SEED=42

# ------------------------------------------------------------------------------
# LangGraph AI agent (Person 2)
# ------------------------------------------------------------------------------

# LLM provider: "openai" (default) or "ollama"
AGENT_LLM_PROVIDER=openai

# Model name (provider-specific)
# OpenAI default: gpt-4o-mini
# Ollama default: llama3.1:8b
AGENT_LLM_MODEL=gpt-4o-mini

# OpenAI API key (required when AGENT_LLM_PROVIDER=openai)
# Never hardcode credentials. Provide via environment or AWS Secrets Manager.
OPENAI_API_KEY=your-openai-api-key-here

# Optional OpenAI base URL (for proxies or compatible endpoints)
OPENAI_BASE_URL=

# Ollama base URL (used when AGENT_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Allow remote Ollama endpoints: "true" or "false"
# When "true", remote endpoints must use HTTPS.
OLLAMA_ALLOW_REMOTE=false

# ------------------------------------------------------------------------------
# AWS (shared with Person 1 — not required for local development)
# ------------------------------------------------------------------------------

# AWS region
AWS_REGION=us-east-1

# S3 bucket for raw/processed data (Person 1)
# Required only if using S3 storage. Not needed for local development.
CREDIT_RISK_BUCKET=your-bucket-name

# AWS credentials — never hardcode. Use AWS credentials file or IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# AWS Secrets Manager (production)
# ------------------------------------------------------------------------------
# In production (AWS ECS/Fargate), secrets such as OPENAI_API_KEY and
# AWS credentials should be stored in AWS Secrets Manager and injected into
# the container environment at runtime. This repository does not include a
# secrets manager client; configure secrets at the orchestration layer.
# ------------------------------------------------------------------------------
